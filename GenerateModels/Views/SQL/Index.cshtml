@{
    ViewBag.Title = "SQL Page (ANCO1)";
}

<div class="jumbotron">
    <h1>SQL Module (ANCO1)</h1>
</div>
<div class="container">
    <div class="row">
        <div class="col-md-12" align="center">
            <p>
                <button class="btn blue" type="button" onclick="WriteObject000(this, 0)">Generate to merge database</button>
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12" align="center">
            <p>
                <button class="btn blue" type="button" onclick="window.location.href='MSSQL'">Open MSSQL</button>
            </p>
        </div>
    </div>

    <div class="row">
        <label class="resultGenerate hide">
            <span class="msg"></span>
            <a href="javascript:void(0)" onclick="$(this).parent().addClass('hide');" class="msg">Close</a>
        </label>
    </div>
</div>
<script type="text/javascript">
    var buttons = $('button.btn.blue');
    var resultGenerate = $('.resultGenerate');

    var WriteObject000 = function (btnA, type) {
        $('.loadingPage').removeClass('hide');

        $(buttons).prop('disabled', true);

        $.ajax({
            url: 'WriteObject00'+ type,
            dataType: 'json',
            type: 'POST',
            contentType: 'application/json',
            success: function (result) {
                $('.loadingPage').addClass('hide');
                resultGenerate.find('span.msg').html(result.msg);
                resultGenerate.removeClass("R0").removeClass("R1").removeClass('hide').addClass(`R${result.status}`);
                $(buttons).prop('disabled', false);
                if (result.link != "") {
                    console.log(result.link);
                    window.location.href = 'Download?link=' + result.link;
                }
            }
        });
    };

</script>
