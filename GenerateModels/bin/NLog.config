<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.microsoft.com/nlog/v2/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true">

	<targets>
		<target xsi:type="File" name="runLog"
				fileName="${basedir}/Logs/Generation_${shortdate}.log"
				layout="${longdate} | ${level:uppercase=true} | ${message} ${exception:format=tostring}"
				archiveAboveSize="10485760"
				maxArchiveFiles="5" />
	</targets>

	<rules>
		<logger name="*" minlevel="Info" writeTo="runLog" />
	</rules>
</nlog>