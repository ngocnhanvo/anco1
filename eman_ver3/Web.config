  <appSettings>
    <add key="owin:AutomaticAppStartup" value="false" />
  </appSettings>
  <connectionStrings>
    <add name="edoc2014ConnectionString" connectionString="Data Source=103.45.229.32;Initial Catalog=emanvg;Persist Security Info=True;User ID=sa;Password=edoc,123@456;multipleactiveresultsets=True;application name=EntityFramework" providerName="System.Data.SqlClient" />
